<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" width="512" height="512">
  <defs>
    <linearGradient id="g" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#7aa2f7"/>
      <stop offset=".55" stop-color="#9a7cf4"/>
      <stop offset="1" stop-color="#b48cf7"/>
    </linearGradient>
    <linearGradient id="bag" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"/>
      <stop offset="1" stop-color="#eef0ff"/>
    </linearGradient>
    <filter id="sh" x="-30%" y="-30%" width="160%" height="160%">
      <feDropShadow dx="0" dy="10" stdDeviation="14" flood-color="#1a1440" flood-opacity=".28"/>
    </filter>
  </defs>
  <rect width="512" height="512" rx="114" fill="url(#g)"/>
  <g filter="url(#sh)">
    <!-- handle: wide, slim arch (reads as a bag, not a padlock) -->
    <path d="M186 178v-20a70 70 0 0 1 140 0v20" fill="none" stroke="#fff" stroke-width="24" stroke-linecap="round"/>
    <!-- bag body -->
    <path d="M124 176h264a12 12 0 0 1 12 13l-15 190a40 40 0 0 1-40 37H167a40 40 0 0 1-40-37l-15-190a12 12 0 0 1 12-13z" fill="url(#bag)"/>
  </g>
  <!-- the Omarchy mark, exact geometry, centred in the bag body -->
  <g transform="translate(193 233) scale(.105)">
    <path fill="#6a4fd6" fill-rule="evenodd" clip-rule="evenodd" d="m1200 1200h-480v-80h400v-1040h-479.996v160h-400v720h720v-720h-80v-80h159.996v880h-400v160h-640v-1200h1200zm-1120-80h480v-80h-400l.004-400h-80.004zm0-560h80.004v-400h400v-80h-480.004z"/>
  </g>
</svg>
